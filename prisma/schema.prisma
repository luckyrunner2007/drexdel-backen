generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "auth"]
}

// ============================================
// USER & AUTH
// ============================================
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  phoneNumber       String?   @unique
  passwordHash      String
  name              String
  username          String?   @unique
  bio               String?   @db.Text
  avatarUrl         String?
  isVerified        Boolean   @default(false)
  role              UserRole  @default(CASUAL)
  
  escrowBalance     Decimal   @default(0) @db.Decimal(10, 2)
  devicePushToken   String?
  presenceVisibility PresenceVisibility @default(FRIENDS_ONLY)
  
  isAccountLocked   Boolean   @default(false)
  failedLoginAttempts Int     @default(0)
  lockedUntil       DateTime?
  
  // RELATIONS (back-relations added)
  organizedEvents   Event[]         // <-- ADDED: Event.organizer points here
  tickets           Ticket[]
  payments          Payment[]
  messages          Message[]
  attendedEvents    UserAttendedEvent[]
  following         UserFollow[]  @relation("Follower")  // follows this user has created
  followedBy        UserFollow[]  @relation("Followee")  // follows where this user is the followee
  conversationMemberships ConversationMember[]

   posts             Post[]
   comments          Comment[]
   likes             Like[]
   sharesGiven       Share[] @relation("SharesGiven")
   sharesReceived    Share[] @relation("SharesReceived")
  savedPosts          SavedPost[]
  reportsWritten      PostReport[]
  reportsReceived     UserReport[] @relation("ReportedUser")
     userReports          UserReport[] @relation("UserReports")
   errorReports          ErrorReport[]
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  
  
  
  
  @@schema("public")
}

enum UserRole {
  CASUAL
  ORGANISER
  STAFF
  ADMIN
  @@schema("public")
}

enum PresenceVisibility {
  PUBLIC
  FRIENDS_ONLY
  HIDDEN
  @@schema("public")
}

// ============================================
// ERROR REPORTING
// ============================================
model ErrorReport {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  message       String   @db.Text
  stack         String?  @db.Text
  componentStack String? @db.Text
  platform      String?
  appVersion    String?
  deviceInfo    Json?
  url           String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([platform])
  @@schema("public")
}

// ============================================
// EVENTS
// ============================================
model Event {
  id              String    @id @default(cuid())
  title           String
  description     String    @db.Text
  date            DateTime
  endDate         DateTime?
  location        String
  latitude        Float?
  longitude       Float?
  category        String?
  status          EventStatus @default(DRAFT)
  
  coverImageUrl   String?
  galleryUrls     String[]  @default([])
  
  // Organizer relation
  organizerId     String
  organizer       User      @relation(fields: [organizerId], references: [id])
  
  // RELATIONS (back-relations added)
  ticketTiers     TicketTier[]
  tickets         Ticket[]        // <-- ADDED: Ticket.event points here
  payments        Payment[]       // <-- ADDED: Payment.event points here
  /// Back-relation: media posts attached to this event (past memories or upcoming reels).
  posts             Post[]
  
  totalCapacity   Int       @default(0)
  ticketsSold     Int       @default(0)
  grossRevenue    Decimal   @default(0) @db.Decimal(12, 2)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  
  
  
  
  @@schema("public")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
  @@schema("public")
}

// ============================================
// TICKET TIERS
// ============================================
model TicketTier {
  id              String    @id @default(cuid())
  eventId         String
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  name            String
  price           Decimal   @db.Decimal(10, 2)
  currency        String    @default("RWF")
  
  totalAllocation Int
  ticketsSold     Int       @default(0)
  isActive        Boolean   @default(true)
  maxPerUser      Int       @default(10)
  
  // RELATIONS (back-relation added)
  tickets         Ticket[]  // <-- ADDED: Ticket.tier points here
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  
  @@unique([eventId, name])
  @@schema("public")
}

// ============================================
// TICKETS
// ============================================
model Ticket {
  id                String    @id @default(cuid())
  transactionId     String    @unique
  
  eventId           String
  event             Event     @relation(fields: [eventId], references: [id])
  
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  
  tierId            String
  tier              TicketTier @relation(fields: [tierId], references: [id])
  
  cryptographicToken String   @db.Text
  qrCodeString      String    @db.Text
  
  status            TicketStatus @default(BOOKED)
  usedAt            DateTime?
  usedBy            String?
  
  syncVersion       Int       @default(1)
  lastSyncedAt      DateTime?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  
  
  
  @@schema("public")
}

enum TicketStatus {
  BOOKED
  USED
  CANCELLED
  REFUNDED
  @@schema("public")
}

// ============================================
// PAYMENTS
// ============================================
model Payment {
  id              String    @id @default(cuid())
  transactionId   String    @unique
  
  eventId         String
  event           Event     @relation(fields: [eventId], references: [id])
  
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  
  amount          Decimal   @db.Decimal(10, 2)
  currency        String    @default("RWF")
  
  paymentMethod   PaymentMethod
  provider        String
  tierId          String?
  
  customerPhone   String?
  customerEmail   String?
  
  gatewayReference String?
  gatewayResponse Json?
  
  status          PaymentStatus @default(PENDING)
  errorMessage    String?
  
  idempotencyKey  String    @unique
  
  webhookReceivedAt DateTime?
  webhookPayload    Json?
  
  refundedAmount  Decimal?  @db.Decimal(10, 2)
  refundedAt      DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  
  
  
  
  @@schema("public")
}

enum PaymentMethod {
  CREDIT_CARD
  PAYPAL
  MTN_MOMO
  AIRTEL_MONEY
  @@schema("public")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  DISPUTED
  @@schema("public")
}

// ============================================
// CONVERSATIONS (DMs + future group chats)
// ============================================
enum ConversationType {
  DIRECT
  GROUP
  @@schema("public")
}

enum ConversationMemberRole {
  ADMIN
  MEMBER
  @@schema("public")
}

model Conversation {
  id                 String             @id @default(cuid())
  type               ConversationType   @default(DIRECT)
  /// For DIRECT chats: sorted "userIdA:userIdB" pair key for unique lookup.
  pairKey            String?            @unique
  title              String?
  /// Group avatar image URL (null for DMs).
  avatarUrl          String?
  /// Group description (null for DMs).
  description        String?            @db.Text
  /// Whether the group is discoverable/joinable by non-members.
  isPublic           Boolean            @default(false)
  /// Creator / owner of the conversation (for groups).
  createdBy          String?
  lastMessageAt      DateTime?
  lastMessagePreview String?

  members            ConversationMember[]
  messages           Message[]

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  
  
  
  @@schema("public")
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Last time this member opened / marked the thread read.
  lastReadAt     DateTime?
  muted          Boolean      @default(false)
  joinedAt       DateTime     @default(now())
  /// Role within the conversation (ADMIN for group creator, MEMBER for others).
  role           ConversationMemberRole @default(MEMBER)

  @@unique([conversationId, userId])
  
  
  @@schema("public")
}

// ============================================
// MESSAGES
// ============================================
model Message {
  id             String    @id @default(cuid())
  /// Event bond-room channel ("event_{eventId}"). Null for DM messages.
  roomId         String?
  /// DM / conversation thread. Null for event bond-room messages.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId       String
  sender         User      @relation(fields: [senderId], references: [id])

  content        String    @db.Text
  messageType    MessageType @default(TEXT)

  attachments    Json?
  callData       Json?

  isSoftDeleted  Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?

  isEdited       Boolean   @default(false)
  editedAt       DateTime?

  pollData       Json?
  reactions      Json?

  deliveredAt    DateTime?
  readAt         DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  
  
  
  @@schema("public")
}

enum MessageType {
  TEXT
  IMAGE
  EVENT_CARD
  POLL
  SYSTEM
  @@schema("public")
}

// ============================================
// JOIN TABLES
// ============================================
model UserAttendedEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  eventId     String
  checkedInAt DateTime @default(now())
  ticketId    String?
  
  @@unique([userId, eventId])
  
  @@schema("public")
}

// ============================================
// SOCIAL GRAPH (Event-Backed, like Instagram)
// ============================================
enum UserFollowStatus {
  REQUESTED
  ACCEPTED
  BLOCKED
  @@schema("public")
}

model UserFollow {
  id         String          @id @default(cuid())
  followerId String
  follower   User            @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followeeId String
  followee   User            @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)

  status     UserFollowStatus @default(ACCEPTED)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([followerId, followeeId])
  
  
  
  @@schema("public")
}

// ============================================
// IDEMPOTENCY KEYS
// ============================================
model IdempotencyKey {
  key       String   @id
  scope     String
  response  Json
  expiresAt DateTime
  
  
  @@schema("public")
}

// ============================================
// MEDIA POSTS / UPLOAD FEATURE
// ============================================
enum MediaType {
  IMAGE
  VIDEO
  @@schema("public")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  @@schema("public")
}

model Post {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId           String?
  event             Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  mediaUrl          String      @db.Text
  mediaType         MediaType
  thumbnailUrl      String?     @db.Text
  durationSeconds   Int?
  caption           String      @db.Text
  status            PostStatus  @default(DRAFT)
  isPastEventMemory     Boolean   @default(false)
  isUpcomingEventReel   Boolean   @default(false)
  isSoftDeleted     Boolean     @default(false)
  deletedAt         DateTime?
  deletedBy         String?
  likes             Like[]
  comments          Comment[]
  shares            Share[]
  isEdited          Boolean     @default(false)
  editedAt          DateTime?
  isReported        Boolean     @default(false)
  saves             SavedPost[]
  reports           PostReport[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  
  
  
  
  @@schema("public")
}

model Comment {
  id              String    @id @default(cuid())
  postId          String
  post            Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content         String    @db.Text
  parentCommentId String?
  parentComment   Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         Comment[] @relation("CommentReplies")
  isSoftDeleted   Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  
  @@schema("public")
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([postId, userId])
  
  
  
  @@schema("public")
}

model Share {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  sharedById String
  sharedBy   User     @relation("SharesGiven", fields: [sharedById], references: [id], onDelete: Cascade)
  sharedToId String
  sharedTo   User     @relation("SharesReceived", fields: [sharedToId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@unique([postId, sharedById, sharedToId])
  
  
  @@schema("public")
}

model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@schema("public")
}

model PostReport {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    PostReportReason
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([userId])
  @@schema("public")
}


model UserReport {
  id        String   @id @default(cuid())
  userId    String
  user      User      @relation("UserReports", fields: [userId], references: [id], onDelete: Cascade)
  targetId  String
  target    User      @relation("ReportedUser", fields: [targetId], references: [id], onDelete: Cascade)
  reason    UserReportReason
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([targetId])
  @@schema("public")
}

enum UserReportReason {
  SPAM
  HARMFUL
  IMPERSONATION
  COPYRIGHT
  OTHER
  @@schema("public")
}

enum PostReportReason {
  SPAM
  HARMFUL
  IMPERSONATION
  COPYRIGHT
  OTHER
  @@schema("public")
}
