{
  "name": "drexdel-backend",
  "version": "1.0.0",
  "type": "commonjs",
  "description": "Project Drexdel High-Concurrency Cloud Backend Framework",
  "main": "src/app.ts",
  "scripts": {
    "dev": "ts-node src/app.ts",
    "start": "node -r ts-node/register src/app.ts",
    "dev:worker": "ts-node src/workers/index.ts",
    "start:worker": "node -r ts-node/register src/workers/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "loadtest": "k6 run k6/load-test.js --vus 10000 --duration 1m",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "db:restore:test": "node scripts/restore-test.js"
  },
  "dependencies": {
    "@paypal/checkout-server-sdk": "1.0.3",
    "@prisma/client": "5.22.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@supabase/supabase-js": "^2.112.2",
    "@types/jsonwebtoken": "9.0.10",
    "bullmq": "5.78.1",
    "compression": "1.8.1",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "express-rate-limit": "8.5.2",
    "helmet": "8.2.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "jwks-rsa": "2.1.5",
    "nodemailer": "^6.10.1",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "prisma": "5.22.0",
    "redis": "6.0.1",
    "socket.io": "4.8.3",
    "stripe": "22.4.0",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/helmet": "0.0.48",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.21",
    "@types/nodemailer": "^6.4.24",
    "@types/supertest": "2.0.16",
    "jest": "29.7.0",
    "supertest": "6.3.4",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
